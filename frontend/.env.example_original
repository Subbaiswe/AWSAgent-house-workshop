# Cognito Configuration
VITE_COGNITO_DOMAIN=  # From CloudFormation output: CognitoDomain
VITE_CLIENT_ID=       # From CloudFormation output: WebClientId
# IMPORTANT: Set this to the region where the workshop is deployed. Ask your facilitator if unsure.
VITE_AWS_REGION=

# Backend Configuration
# Configure both URLs to enable the backend switcher in the UI
# Local agent (Docker): runs on localhost:8081
VITE_LOCAL_BACKEND_URL=http://localhost:8081/invocations
# Deployed agent (AgentCore): get from `make outputs` after deployment
VITE_DEPLOYED_BACKEND_URL=
