# AWS Configuration
# IMPORTANT: Set this to the region where the workshop is deployed.
# Ask your workshop facilitator if unsure.
AWS_REGION=

# Camera Configuration
KVS_STREAM_NAME=backyard

# Temperature Database Configuration
ATHENA_DATABASE=house_db
ATHENA_TABLE=temperature_readings
ATHENA_OUTPUT_BUCKET=               # From CloudFormation output

# Bedrock Models
AGENT_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
IMAGE_MODEL_ID=global.amazon.nova-2-lite-v1:0

# MCP Server (from CloudFormation output: HeaterMcpUrl)
MCP_SERVER_URL=
HEATER_OAUTH_MCP_URL=  # From CloudFormation output: HeaterOAuthMcpUrl (for Gateway with OAuth)

# Weather API (from CloudFormation outputs)
WEATHER_API_URL=
WEATHER_API_KEY=

# Cognito Authentication (for AgentCore deployment)
USER_POOL_ID=    # From CloudFormation output
WEB_CLIENT_ID=   # From CloudFormation output (Authorization Code flow)
M2M_CLIENT_ID=   # From CloudFormation output (Client Credentials flow)
COGNITO_DOMAIN=  # From CloudFormation output (e.g., agent-frontend-123456789012)

# Video Clip URL Shortener (from CloudFormation output: UrlShortenerUrl)
URL_SHORTENER_URL=

# ---- Variables below are populated as you progress through the workshop ----

# Deploying to AWS (Module 3)
M2M_CLIENT_SECRET=  # Run: aws cognito-idp describe-user-pool-client --user-pool-id $USER_POOL_ID --client-id $M2M_CLIENT_ID --query 'UserPoolClient.ClientSecret' --output text
AGENT_ENDPOINT=     # From: make outputs (after deployment)

# Short- and Long-Term Memory (Module 4)
MEMORY_ID=          # From: make outputs (after adding memory to template.yaml)

# AgentCore Gateway (Module 6)
AC_GATEWAY_URL=     # From: make outputs (after adding gateway to template.yaml)
